#!/usr/bin/bash
set -euo pipefail

# RustD owns initramfs generation during image assembly.  Kernel package
# scripts still call this compatibility entry point, so accept the standard
# add/remove verbs without handing control to a foreign service manager.
case "${1:-}" in
    add|remove|inspect|list)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
