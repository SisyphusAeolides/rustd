#!/bin/bash
set -euo pipefail

# Kernel package scriptlets use this standard pathname. Keep the pathname
# stable for RPM compatibility while delegating the actual boot-artifact
# transaction to RustD's native implementation.
if test -x /usr/bin/rustkernel-install; then
    exec /usr/bin/rustkernel-install "$@"
fi

printf '%s\n' 'kernel-install: RustD kernel installer is unavailable' >&2
exit 127
