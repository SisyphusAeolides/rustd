policy_module(rustd_fedora, 1.0.0)

# RustD deliberately reuses Fedora's mature confinement domains for equivalent
# system roles. This module introduces one new writable data type for the
# resolver's RFC5011 state; it does not make any RustD process permissive or
# unconfined.
gen_require(`
    type init_var_lib_t;
    type init_exec_t;
    type init_t;
    type kernel_t;
    type systemd_resolved_t;
    attribute domain;
    attribute device_node;
')

type rustd_resolved_var_lib_t;
files_type(rustd_resolved_var_lib_t)

# RustD remains Fedora's PID 1 implementation and therefore runs in kernel_t.
# Its compatibility generators are invoked directly by that PID 1 path, so
# they need no-transition execute permission. Use Fedora's existing init
# executable type here: the image builder can apply this standard label while
# the target SELinux policy is not yet active. A newly introduced executable
# type would otherwise be emitted as unlabeled_t in a live squashfs image.
can_exec(kernel_t, init_exec_t)

# RustD applies Fedora service hardening in the same child setup phase as
# systemd, including PR_SET_NO_NEW_PRIVS for units with MemoryDenyWriteExecute,
# RestrictRealtime, or related filters. Preserve the existing SELinux domain
# transitions when that flag is set; this grants only the process2 transition
# permissions and does not create any new domain transitions.
allow init_t domain:process2 { nnp_transition nosuid_transition };

# RustD is Fedora's PID 1 implementation and starts in kernel_t. Fedora's
# device manager normally performs this relabeling from its confined udev
# domain; RustD owns that path, so grant only device-node relabel operations.
# This does not grant relabeling of regular files, directories, or arbitrary
# SELinux types.
allow kernel_t device_node:{ chr_file blk_file } { relabelfrom relabelto };

# /var/lib/rustd is init-owned; rustd-resolved only needs to traverse that
# parent and manage its dedicated /var/lib/rustd/resolved subtree.
search_dirs_pattern(systemd_resolved_t, init_var_lib_t, init_var_lib_t)
manage_dirs_pattern(systemd_resolved_t, rustd_resolved_var_lib_t, rustd_resolved_var_lib_t)
manage_files_pattern(systemd_resolved_t, rustd_resolved_var_lib_t, rustd_resolved_var_lib_t)
manage_lnk_files_pattern(systemd_resolved_t, rustd_resolved_var_lib_t, rustd_resolved_var_lib_t)
