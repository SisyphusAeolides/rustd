policy_module(rustd_fedora, 1.0.0)

# RustD deliberately reuses Fedora's mature confinement domains for equivalent
# system roles. This module introduces one new writable data type for the
# resolver's RFC5011 state; it does not make any RustD process permissive or
# unconfined.
gen_require(`
    type init_var_lib_t;
    type init_exec_t;
    type init_t;
    type kernel_t;
    type dbusd_exec_t;
    type system_dbusd_t;
    type NetworkManager_exec_t;
    type NetworkManager_t;
    type chronyd_exec_t;
    type chronyd_t;
    type sshd_exec_t;
    type sshd_t;
    type systemd_hostnamed_exec_t;
    type systemd_hostnamed_t;
    type systemd_localed_exec_t;
    type systemd_localed_t;
    type systemd_logind_exec_t;
    type systemd_logind_t;
    type systemd_resolved_exec_t;
    type systemd_resolved_t;
    type udev_exec_t;
    type udev_t;
    type boot_t;
    type syslogd_var_run_t;
    attribute domain;
    attribute device_node;
')

type rustd_resolved_var_lib_t;
files_type(rustd_resolved_var_lib_t)

# RustD remains Fedora's PID 1 implementation and therefore runs in kernel_t.
# Its compatibility generators are invoked directly by that PID 1 path, so
# they need no-transition execute permission. Use Fedora's existing init
# executable type here: the image builder can apply this standard label while
# the target SELinux policy is not yet active. A newly introduced executable
# type would otherwise be emitted as unlabeled_t in a live squashfs image.
can_exec(kernel_t, init_exec_t)

# RustD intentionally keeps its PID-1 process in Fedora's kernel_t domain.
# Fedora's standard service domains are normally entered from systemd's
# init_t, so make the equivalent, narrowly scoped transitions explicit for
# every daemon RustD starts during the Fedora cutover.  This preserves each
# daemon's existing confinement instead of executing it unconfined in
# kernel_t.
domtrans_pattern(kernel_t, dbusd_exec_t, system_dbusd_t)
domtrans_pattern(kernel_t, NetworkManager_exec_t, NetworkManager_t)
domtrans_pattern(kernel_t, chronyd_exec_t, chronyd_t)
domtrans_pattern(kernel_t, sshd_exec_t, sshd_t)
domtrans_pattern(kernel_t, systemd_hostnamed_exec_t, systemd_hostnamed_t)
domtrans_pattern(kernel_t, systemd_localed_exec_t, systemd_localed_t)
domtrans_pattern(kernel_t, systemd_logind_exec_t, systemd_logind_t)
domtrans_pattern(kernel_t, systemd_resolved_exec_t, systemd_resolved_t)
domtrans_pattern(kernel_t, udev_exec_t, udev_t)

# Mount units are executed by RustD's kernel_t PID1.  Fedora's init_t policy
# already permits mounting on boot_t; carry only that directory mountpoint
# permission across the native manager boundary so /boot/efi and equivalent
# ESP mounts remain available in enforcing mode.
allow kernel_t boot_t:dir mounton;

# RustD applies Fedora service hardening in the same child setup phase as
# systemd, including PR_SET_NO_NEW_PRIVS for units with MemoryDenyWriteExecute,
# RestrictRealtime, or related filters. Preserve the existing SELinux domain
# transitions when that flag is set; this grants only the process2 transition
# permissions and does not create any new domain transitions.
allow init_t domain:process2 { nnp_transition nosuid_transition };

# RustD's PID-1 D-Bus worker is the system-bus client for the manager API. The
# stock systemd policy grants this to systemd's init domain; RustD needs the
# equivalent relationship when it owns PID 1 and starts the bus itself.
dbus_system_bus_client(init_t)
# Some Fedora boot paths enter RustD through the kernel/init transition before
# the conventional init_t label is established. Keep the manager's system-bus
# client permission valid across that early handoff as well.
dbus_system_bus_client(kernel_t)
# RustD also owns its manager well-known name on the system bus. The generic
# client interface intentionally grants messaging only; acquire the service
# name explicitly for both labels used during the PID-1 handoff.
dbus_connect_system_bus(init_t)
dbus_connect_system_bus(kernel_t)

# The standard login1 D-Bus service is activated by the confined system bus.
# RustD logind is labeled with Fedora's existing logind entrypoint type, so it
# must enter Fedora's existing logind domain exactly as systemd-logind does.
# Without this transition, enforcing SELinux rejects the D-Bus activation even
# though the service file and executable are present.
domtrans_pattern(system_dbusd_t, systemd_logind_exec_t, systemd_logind_t)

# Direct D-Bus activation is retained for deployments whose bus is not
# configured for system-manager activation. dbus-daemon writes the inherited
# activation pipe while the logind service is coming up; Fedora's stock
# systemd-logind is normally started by systemd and therefore does not need
# this permission in the base policy. Restrict it to the existing logind
# domain and FIFO object class.
allow system_dbusd_t systemd_logind_t:fifo_file write;

# RustD journald publishes systemd-compatible links from its native runtime
# directory. Keep that compatibility surface confined to the existing Fedora
# syslog runtime type.
manage_lnk_files_pattern(init_t, syslogd_var_run_t, syslogd_var_run_t)

# RustD is Fedora's PID 1 implementation and starts in kernel_t. Fedora's
# device manager normally performs this relabeling from its confined udev
# domain; RustD owns that path, so grant only device-node relabel operations.
# This does not grant relabeling of regular files, directories, or arbitrary
# SELinux types.
allow kernel_t device_node:{ chr_file blk_file } { relabelfrom relabelto };

# /var/lib/rustd is init-owned; rustd-resolved only needs to traverse that
# parent and manage its dedicated /var/lib/rustd/resolved subtree.
search_dirs_pattern(systemd_resolved_t, init_var_lib_t, init_var_lib_t)
manage_dirs_pattern(systemd_resolved_t, rustd_resolved_var_lib_t, rustd_resolved_var_lib_t)
manage_files_pattern(systemd_resolved_t, rustd_resolved_var_lib_t, rustd_resolved_var_lib_t)
manage_lnk_files_pattern(systemd_resolved_t, rustd_resolved_var_lib_t, rustd_resolved_var_lib_t)
