/usr/lib/rustd/rustd                         --  gen_context(system_u:object_r:init_exec_t,s0)
/usr/lib/rustd/rustd-logind                  --  gen_context(system_u:object_r:systemd_logind_exec_t,s0)
/usr/lib/rustd/rustd-udevd                   --  gen_context(system_u:object_r:udev_exec_t,s0)
/usr/lib/rustd/rustd-resolved                --  gen_context(system_u:object_r:systemd_resolved_exec_t,s0)
# RustD invokes these compatibility generators from its PID1 path. Fedora's
# generic generator executable type grants the same execute transition policy
# used for systemd system-generators without creating a new RustD domain.
/usr/lib/rustd/rustd-.*-generator             --  gen_context(system_u:object_r:systemd_generic_generator_exec_t,s0)

/run/rustd(/.*)?                                 gen_context(system_u:object_r:init_var_run_t,s0)
/run/rustd/sessions(/.*)?                        gen_context(system_u:object_r:systemd_logind_sessions_t,s0)
/run/rustd/users(/.*)?                           gen_context(system_u:object_r:systemd_logind_var_run_t,s0)
/run/rustd/seats(/.*)?                           gen_context(system_u:object_r:systemd_logind_var_run_t,s0)
/run/rustd/resolve(/.*)?                         gen_context(system_u:object_r:systemd_resolved_var_run_t,s0)
/run/dnssec-trust-anchors\.d(/.*)?                gen_context(system_u:object_r:systemd_resolved_var_run_t,s0)

/var/lib/rustd(/.*)?                             gen_context(system_u:object_r:init_var_lib_t,s0)
/var/lib/rustd/resolved(/.*)?                    gen_context(system_u:object_r:rustd_resolved_var_lib_t,s0)
