# RustD invokes these compatibility generators directly from its kernel_t PID1
# path, so they use Fedora's existing init executable type with no transition.
/usr/lib/rustd/rustd-.*-generator             --  gen_context(system_u:object_r:init_exec_t,s0)

/run/rustd(/.*)?                                 gen_context(system_u:object_r:init_var_run_t,s0)
