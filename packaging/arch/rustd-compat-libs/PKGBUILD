# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=rustd-compat-libs
pkgver=0.1.0
pkgrel=1
pkgdesc='Certified libsystemd/libudev ABI compatibility libraries backed by RustD'
arch=('x86_64')
url='https://github.com/SisyphusAeolides/rustd'
license=('LGPL-2.1-or-later')
depends=('rustd' 'dbus' 'json-c')
makedepends=('rust' 'gfortran' 'pkgconf' 'dbus' 'json-c' 'git')
provides=('systemd-libs' 'libsystemd.so=0-64' 'libudev.so=1-64')
conflicts=('systemd-libs')
source=("rustd::git+${url}.git#commit=${_commit}")
b2sums=('SKIP')

# Package builds must pin the exact RustD release candidate. The release
# tooling replaces this value before package creation.
_commit='REPLACE_WITH_CERTIFIED_RUSTD_SHA'

prepare() {
  cd "$srcdir/rustd"
  test "$(git rev-parse HEAD)" = "$_commit"
}

build() {
  cd "$srcdir/rustd"
  make compat
  python3 scripts/check-compat-source-readiness.py \
    --report target/compat-readiness.json --require-complete
}

check() {
  cd "$srcdir/rustd"
  make check-compat
  python3 scripts/check-compat-source-readiness.py \
    --report target/compat-readiness.json --require-complete
}

package() {
  cd "$srcdir/rustd"
  make DESTDIR="$pkgdir" PREFIX=/usr install-compat
  test -f "$pkgdir/usr/lib/libsystemd.so.0"
  test -f "$pkgdir/usr/lib/libudev.so.1"
  bash scripts/check-compat-libs.sh "$pkgdir/usr"
}
