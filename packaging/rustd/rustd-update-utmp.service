[Unit]
Description=RustD Boot and Shutdown Accounting
DefaultDependencies=no
After=local-fs.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/rustd/rustd-update-utmp reboot
ExecStop=/usr/lib/rustd/rustd-update-utmp shutdown
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
