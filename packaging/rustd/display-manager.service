[Unit]
Description=Display Manager
# Distro packages (sddm, gdm, lightdm, plasmalogin) create Alias=display-manager.service
# under /etc/rustd/system. That root is searched before /usr/lib/rustd/system,
# so an enabled display manager replaces this placeholder.
# Host profile: packaging ships plasmalogin.service with Alias=display-manager.service;
# enable it with: rustctl enable plasmalogin.service
# Until then this unit satisfies Wants=display-manager.service on graphical.target.
After=multi-user.target rustd-logind.service dbus.service
Wants=dbus.service rustd-logind.service

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
