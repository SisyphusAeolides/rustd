[Unit]
Description=RustD Device Event Manager
Documentation=man:rustd-udevd(8)
DefaultDependencies=no
After=rustd-sysusers.service rustd-tmpfiles-setup-dev.service
Before=sysinit.target
# udev only reads sysfs while processing kernel events.  Live media and
# containers may expose sysfs read-only even though device-event handling is
# fully functional, so writability must not suppress the device manager.
ConditionPathExists=/sys

[Service]
Type=simple
StandardOutput=null
StandardError=null
ExecStart=/usr/lib/rustd/rustd-udevd
Restart=always
RestartSec=1s
KillMode=mixed

[Install]
WantedBy=sysinit.target
