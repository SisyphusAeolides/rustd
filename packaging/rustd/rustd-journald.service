[Unit]
Description=RustD Journal Service
DefaultDependencies=no
After=local-fs.target rustd-tmpfiles-setup.service
Requires=rustd-tmpfiles-setup.service
Before=sysinit.target

[Service]
Type=simple
StandardOutput=null
StandardError=null
ExecStartPre=/usr/bin/mkdir -p /run/rustd/journal
ExecStartPre=/usr/sbin/restorecon -F /run/rustd /run/rustd/journal
ExecStart=/usr/lib/rustd/rustd-journald --runtime-directory /run/rustd/journal
Restart=always
RestartSec=1s
StartLimitIntervalSec=30
StartLimitBurst=5

[Install]
WantedBy=sysinit.target
